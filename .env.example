# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube a GitHub (ver .gitignore).

# --- Sanity ---
# Los tres siguientes los obtienes al crear tu proyecto en sanity.io
# (ver README.md, paso 3). Mientras NEXT_PUBLIC_SANITY_PROJECT_ID esté
# vacío, la web funciona igualmente con datos de ejemplo locales.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Token de lectura de Sanity (Settings → API → Tokens → Add API token,
# permisos "Viewer" es suficiente). Necesario para la vista previa de
# borradores (Visual Editing / Presentation) en /studio.
SANITY_API_READ_TOKEN=

# Token de ESCRITURA de Sanity (Settings → API → Tokens → Add API
# token, permisos "Editor"). Solo lo usa scripts/seed-sanity.ts (el
# comando `pnpm sanity:seed`) para crear/actualizar el contenido
# inicial. No es necesario para el día a día de la web ni de
# /studio — créalo únicamente cuando vayas a ejecutar el seed, y
# nunca lo compartas ni lo pegues en ningún archivo del proyecto.
SANITY_API_WRITE_TOKEN=

# --- Sitio ---
# URL pública final del sitio (para sitemap.xml, robots.txt y metadatos
# Open Graph). En local puedes dejar el valor por defecto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Airtable (V2: envío de formularios) ---
# Usados solo por app/api/forms/submit/route.ts, en el servidor. NUNCA
# les pongas el prefijo NEXT_PUBLIC_ (eso los expondría al navegador).
# AIRTABLE_PAT: Airtable → tu cuenta → Developer hub → Personal access
# tokens → Create token, con scopes data.records:write y
# data.records:read sobre la base de Bellaterra Conecta.
# AIRTABLE_BASE_ID: lo ves en la URL de la base (empieza por "app...").
# AIRTABLE_SUBMISSIONS_TABLE: nombre exacto de la tabla, ej. "Submissions".
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_SUBMISSIONS_TABLE=Submissions
